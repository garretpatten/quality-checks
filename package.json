{
  "name": "quality-checks",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run format:check && npm run lint:md && npm run lint:yaml && npm run lint:workflows",
    "lint:changed": "./scripts/lint-changed.sh",
    "lint:md": "markdownlint-cli2",
    "lint:yaml": "yamllint .github .yamllint .markdownlint.yaml",
    "lint:workflows": "actionlint",
    "lint:shell": "shfmt -d .github/scripts/*.sh scripts/*.sh"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.18.1",
    "prettier": "^3.6.2"
  }
}
