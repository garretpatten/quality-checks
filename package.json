{
  "name": "quality-checks",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:md": "prettier --write \"**/*.md\"",
    "lint:docs": "npm run format:check && npm run lint:md",
    "fix:docs": "npm run format:md && npm run lint:md",
    "lint": "npm run lint:docs && npm run lint:yaml",
    "lint:changed": "./scripts/lint-changed.sh",
    "lint:md": "markdownlint-cli2",
    "lint:yaml": "yamllint .github .yamllint .markdownlint.yaml",
    "lint:shell": "./scripts/lint-shell.sh",
    "test:shell": "PATH=\"$PWD/.tools/bats/bin:$PATH\" BATS_LIB_PATH=\"$PWD/.tools${BATS_LIB_PATH:+:$BATS_LIB_PATH}\" bats --recursive tests"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.6.2"
  },
  "overrides": {
    "katex": "^0.18.2",
    "smol-toml": "^1.9.0",
    "markdown-it": "^15.0.3"
  }
}
